<Window x:Class="AggPanSearch.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AggPanSearch 搜索功能测试" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 搜索输入区 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="关键词：" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="KeywordBox" Width="260" VerticalContentAlignment="Center"
                     ToolTip="输入要搜索的关键词" KeyDown="KeywordBox_KeyDown" />
            <TextBlock Text="来源：" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox x:Name="SourceBox" Width="90" VerticalContentAlignment="Center"
                      SelectedIndex="0">
                <ComboBoxItem Content="全部" Tag="all" />
                <ComboBoxItem Content="TG" Tag="tg" />
                <ComboBoxItem Content="插件" Tag="plugin" />
            </ComboBox>
            <CheckBox x:Name="RefreshBox" Content="强制刷新" VerticalAlignment="Center" Margin="12,0,0,0" />
            <Button x:Name="SearchButton" Content="搜索" Width="90" Height="26" Margin="16,0,0,0"
                    Click="SearchButton_Click" />
        </StackPanel>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="1" Margin="0,0,0,8">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" Foreground="Gray" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="TotalText" />
            </StatusBarItem>
        </StatusBar>

        <!-- 结果区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 按网盘类型归并结果 -->
            <GroupBox Grid.Column="0" Header="按网盘类型归并" Margin="0,0,8,0">
                <TreeView x:Name="MergedTree" MouseDoubleClick="MergedTree_MouseDoubleClick" />
            </GroupBox>

            <!-- 明细结果 -->
            <GroupBox Grid.Column="1" Header="结果明细">
                <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          MouseDoubleClick="ResultGrid_MouseDoubleClick"
                          GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="频道" Binding="{Binding Channel}" Width="110" />
                        <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="250" />
                        <DataGridTextColumn Header="时间" Binding="{Binding Datetime, StringFormat=yyyy-MM-dd HH:mm}" Width="130" />
                        <DataGridTextColumn Header="链接数" Binding="{Binding Links.Count}" Width="60" />
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>
    </Grid>
</Window>