<Project>
  <PropertyGroup>
	<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
	<PackageVersion Include="BuildBundlerMinifier" Version="3.2.449" />
	<PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="7.0.4" Condition="'$(TargetFramework)' != 'net10.0'" />
	<PackageVersion Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
	<PackageVersion Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
	<!-- Microsoft.CodeAnalysis.FxCopAnalyzers was removed from project references during the .NET 10 migration. -->
	<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.13" />
	<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.13" />
	<PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.13" />
	<!-- 无头浏览器截图（自动截图功能）：服务器需额外执行 playwright install chromium，
	     版本固定为 1.61.0，与 Chromium 1228 对应；升级此版本后必须重新执行 install chromium -->
	<PackageVersion Include="Microsoft.Playwright" Version="1.61.0" />
	<PackageVersion Include="Microsoft.Windows.Compatibility" Version="10.0.13" />
	<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.5.0" />
	<PackageVersion Include="MySqlConnector" Version="2.6.2" />
	<PackageVersion Include="NLog.Web.AspNetCore" Version="6.2.2" />
	<PackageVersion Include="NPOI" Version="2.8.1" />
	<PackageVersion Include="nunit" Version="3.13.3" />
	<PackageVersion Include="NUnit3TestAdapter" Version="4.4.2" />
	<PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="3.21.90" />
	<PackageVersion Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
	<PackageVersion Include="Quartz" Version="3.6.2" />
	<PackageVersion Include="StackExchange.Redis" Version="2.6.104" />
	<PackageVersion Include="Swashbuckle.AspNetCore" Version="6.5.0" />
	<PackageVersion Include="System.Drawing.Common" Version="7.0.0" Condition="'$(TargetFramework)' != 'net10.0'" />
	<PackageVersion Include="System.Drawing.Common" Version="10.0.13" Condition="'$(TargetFramework)' == 'net10.0'" />
	<PackageVersion Include="Azure.Identity" Version="1.21.0" />
	<PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
	<PackageVersion Include="SixLabors.ImageSharp" Version="4.1.3" />
	<PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
	<PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0-rc.2.26504.105" />
	<PackageVersion Include="System.Security.Cryptography.Xml" Version="11.0.0-rc.2.26504.105" />
	<PackageVersion Include="HtmlAgilityPack" Version="1.12.4" />
  </ItemGroup>
</Project>
