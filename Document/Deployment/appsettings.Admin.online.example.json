{
    "Logging": {
        "LogLevel": {
            "Default": "Warning"
        }
    },
    "AllowedHosts": "*",
  "SystemConfig": {
    "Demo": false, // 是否是演示模式
    "LoginMultiple": true, // 是否允许一个账户在多处登录
    "LoginProvider": "Cookie", // 登录信息保存方式 Cookie Session WebApi
    "SnowFlakeWorkerId": 1, // SnowFlake 节点序号
    "ApiSite": "http://localhost:5001", // Api地址，例如可以上传文件到Api（按线上环境调整）
    "VirtualDirectory": "/admin", // 虚拟目录

    "DBProvider": "MySql",
    "DBConnectionString": "server=localhost;database=aggpansearch;user=aggpansearch;password=aggpansearch;port=3306;pooling=true;max pool size=20;persist security info=True;charset=utf8mb4;",
    "DBCommandTimeout": 180, // 数据库超时时间，单位秒
    "DBBackup": "", // 数据库备份路径

    "CacheProvider": "Memory", // 缓存使用方式 Memory Redis
    "RedisConnectionString": "127.0.0.1:6379"
  },
  // 开发模式 / 管理模式 菜单配置：一级菜单按名称匹配
  "MenuMode": {
    // 开发模式下显示的一级菜单（“首页”在布局里固定输出，无需配置）；不配置时用内置默认值
    "DevMenus": [ "单位组织", "系统管理", "系统工具", "实例演示" ],
    // 管理模式下显示的一级菜单；留空表示“除 DevMenus 外的全部一级菜单”
    "ManageMenus": []
  },
  "AggPanSearch": {
    "Proxy": "", // TG 搜索代理地址，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080；留空=直连（国内直连 t.me 通常不通，会导致 0 结果）；线上如需 TG 搜索请配置代理
    "Concurrency": 0, // TG 搜索并发数，0=自动（上限16）
    "AsyncResponseTimeoutSeconds": 4.0, // 最快响应窗口（秒）
    "CacheTtlMinutes": 60 // 结果缓存有效期（分钟）
  }
}