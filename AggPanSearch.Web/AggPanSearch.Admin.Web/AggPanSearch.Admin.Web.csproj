<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyVersion>10.0.0.0</AssemblyVersion>
    <FileVersion>10.0.0.0</FileVersion>
    <Company>AggPanSearch.Admin.Web</Company>
    <Authors>AggPanSearch.Admin.Web</Authors>
    <Product>AggPanSearchAdmin</Product>
    <Copyright>AggPanSearchAdmin</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="dotnet_run.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!--<PackageReference Include="BuildBundlerMinifier" />-->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" />
    <!-- 只为把 playwright.ps1 与 .playwright 驱动复制到站点输出目录，供部署时安装 Chromium -->
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\AggPanSearch.Business\AggPanSearch.Business.AutoJob\AggPanSearch.Business.AutoJob.csproj" />
    <ProjectReference Include="..\..\AggPanSearch.Business\AggPanSearch.Business\AggPanSearch.Business.csproj" />
    <ProjectReference Include="..\..\AggPanSearch.Data\AggPanSearch.Data.EF\AggPanSearch.Data.EF.csproj" />
    <ProjectReference Include="..\..\AggPanSearch.Entity\AggPanSearch.Entity\AggPanSearch.Entity.csproj" />
    <ProjectReference Include="..\..\AggPanSearch.Entity\AggPanSearch.Model\AggPanSearch.Model.csproj" />
    <ProjectReference Include="..\..\AggPanSearch.Util\AggPanSearch.CodeGenerator\AggPanSearch.CodeGenerator.csproj" />
    <ProjectReference Include="..\..\AggPanSearch.Util\AggPanSearch.Util\AggPanSearch.Util.csproj" />
    <ProjectReference Include="..\AggPanSearch.Web.Code\AggPanSearch.Web.Code.csproj" />
    <ProjectReference Include="..\..\AggPanSearch\AggPanSearch.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Areas\UserFrontend\" />
    <Folder Include="Areas\PanManage\" />
  </ItemGroup>

  <ItemGroup>
    <!-- 图片生成模式预览图：随发布复制到站点输出目录 Resource\ModePreview，供「资源图片生成」弹窗展示 -->
    <Content Include="Resource\ModePreview\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
