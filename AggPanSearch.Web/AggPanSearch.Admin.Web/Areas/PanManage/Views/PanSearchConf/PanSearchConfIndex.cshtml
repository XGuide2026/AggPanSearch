    // ---------- 网盘类型 ----------
    // 加载类型清单 + 当前启用项：类型来自后端，未配置（useAll）时按「全部勾选」展示，保留原有默认全部启用的行为
    function loadCloudTypes() {
        ys.ajax({
            url: '@Url.Content("~/PanManage/PanSearchConf/GetCloudTypeListJson")',
            type: 'get',
            success: function (obj) {
                if (!obj || obj.Tag != 1 || !obj.Data) {
                    $('#cloudTypesBox').html('<span class="preview-empty">网盘类型加载失败</span>');
                    $('#cloudTypesEnabled').text('加载失败');
                    return;
                }
                cloudTypeOptions = obj.Data.types || [];
                cloudTypeEnabled = obj.Data.enabled || [];
                var useAll = !!obj.Data.useAll;
                renderCloudTypes(useAll ? cloudTypeOptions.map(function (t) { return t.value; }) : cloudTypeEnabled);
                renderCloudTypeEnabled();
            },
            error: function () {
                $('#cloudTypesBox').html('<span class="preview-empty">网盘类型加载失败</span>');
                $('#cloudTypesEnabled').text('加载失败');
            }
        });
    }

    // value 支持数组或逗号分隔字符串
    function renderCloudTypes(value) {
        var selected = $.isArray(value)
            ? value.map(function (s) { return $.trim(String(s)).toLowerCase(); })
            : String(value == null ? '' : value).split(',').map(function (s) { return $.trim(s).toLowerCase(); });
        if (cloudTypeOptions.length === 0) {
            $('#cloudTypesBox').html('<span class="preview-empty">暂无可用的网盘类型</span>');
            return;
        }
        var html = '';
        for (var i = 0; i < cloudTypeOptions.length; i++) {
            var opt = cloudTypeOptions[i];
            var checked = selected.indexOf(String(opt.value).toLowerCase()) > -1 ? ' checked' : '';
            html += '<label class="checkbox-inline">' +
                '<input type="checkbox" name="cloudType" value="' + escAttr(opt.value) + '"' + checked + ' /> ' +
                escHtml(opt.text) + '</label>';
        }
        $('#cloudTypesBox').html(html);
    }

    // 「当前启用」汇总：全部勾选或一个都不勾（未做限制）都等同全部启用
    function renderCloudTypeEnabled() {
        var checkedTexts = [];
        $('#cloudTypesBox input[name="cloudType"]:checked').each(function () {
            var value = String($(this).val()).toLowerCase();
            for (var i = 0; i < cloudTypeOptions.length; i++) {
                if (String(cloudTypeOptions[i].value).toLowerCase() === value) {
                    checkedTexts.push(cloudTypeOptions[i].text);
                    break;
                }
            }
        });
        var total = cloudTypeOptions.length;
        if (total === 0) {
            $('#cloudTypesEnabled').text('加载中...');
            return;
        }
        if (checkedTexts.length === 0) {
            $('#cloudTypesEnabled').text('全部类型（共 ' + total + ' 个）— 未勾选任何类型时不做过滤，等同全部启用');
        } else if (checkedTexts.length === total) {
            $('#cloudTypesEnabled').text('全部类型（共 ' + total + ' 个，未做限制）');
        } else {
            $('#cloudTypesEnabled').text(checkedTexts.join('、') + '（共 ' + checkedTexts.length + ' / ' + total + ' 个）');
        }
    }

    function checkAllCloudTypes(checked) {
        $('#cloudTypesBox input[name="cloudType"]').prop('checked', !!checked);
        renderCloudTypeEnabled();
    }

    function getCheckedCloudTypes() {
        var result = [];
        $('#cloudTypesBox input[name="cloudType"]:checked').each(function () {
            result.push($(this).val());
        });
        return result;
    }

    // 版权投诉自动生成的关键词：只读展示（橙色徽标），点击/编辑入口统一指向版权投诉页面
    function renderCopyrightBlockWords(value) {
        var words = parseLines(value);
        $('#copyrightBlockWordsCount').text(words.length);
        if (words.length === 0) {
            $('#copyrightBlockWordsBox').html('<span class="preview-empty">暂无版权关键词（「网盘管理 - 版权投诉」审核通过后自动生成）</span>');
            return;
        }
        var html = '';
        for (var i = 0; i < words.length; i++) {
            html += '<span class="preview-item copyright-item" title="' + escAttr(words[i]) + '">' + escHtml(words[i]) + '</span>';
        }
        $('#copyrightBlockWordsBox').html(html);
    }

    // 按逗号/换行/分号拆分并去重（保留原顺序），与后端 NormalizeLines 规则一致
    function parseLines(text) {
        var arr = String(text == null ? '' : text).split(/[,，;；\r\n]+/);
        var seen = {};
        var result = [];
        for (var i = 0; i < arr.length; i++) {
            var s = $.trim(arr[i]);
            var key = s.toLowerCase();
            if (s !== '' && !seen[key]) {
                seen[key] = true;
                result.push(s);
            }
        }
        return result;
    }

    // ---------- 保存 ----------
    function saveCurrentTab() {
        if (currentTab === 'basic') {
            saveBasic();
        } else if (currentTab === 'tgchannels') {
            ys.msgInfo('TG频道的增删改会即时保存，无需点此按钮');
        } else if (EXTRA_TABS.indexOf(currentTab) > -1) {
            saveExtra();
        }
    }

    // 保存搜索设置（按 Id 批量更新）
    function saveBasic() {
        var entities = [];
        $('#basicForm .form-group[data-conf-id]').each(function () {
            var $group = $(this);
            var confId = $group.attr('data-conf-id');
            if (!confId) {
                return;
            }
            var spec = $group.attr('data-conf-spec') || '';
            var $radioChecked = $group.find('input[type="radio"]:checked');
            var value = '';
            if (spec == '4') {
                // 上传图片：取图片地址并去掉 ctx 前缀（imgup 回显时会自动拼接 ctx）
                var $upload = $group.find('.img-box[data-upload="1"]').first();
                value = $upload.length ? $upload.imageUpload('getImageUrl') : '';
                if (value && value.indexOf(ctx) === 0) {
                    value = value.substring(ctx.length);
                }
            } else if ($radioChecked.length > 0) {
                value = $radioChecked.val();
            } else {
                var $control = $group.find('input[type="text"], textarea, select, input[type="checkbox"]').last();
                if ($control.is('input[type="checkbox"]')) {
                    value = $control.prop('checked') ? '1' : '0';
                } else {
                    value = $control.val();
                }
            }
            entities.push({ Id: confId, ConfValue: value });
        });
        if (entities.length === 0) {
            ys.msgInfo('没有可保存的配置项');
            return;
        }
        postJson('@Url.Content("~/PanManage/PanSearchConf/SaveBatchJson")', entities);
    }

    // 保存 搜索插件 / 网盘类型 / 屏蔽词（一次提交全部，避免切换页签时互相覆盖）
    function saveExtra() {
        var param = {
            blockWords: $('#blockWordsInput').val() || '',
            plugins: $('#pluginsInput').val() || '',
            cloudTypes: getCheckedCloudTypes().join(',')
        };
        postJson('@Url.Content("~/PanManage/PanSearchConf/SaveExtraJson")', param);
    }

    function postJson(url, data) {
        $.ajax({
            url: url,
            type: 'post',
            dataType: 'json',
            contentType: 'application/json',
            data: JSON.stringify(data),
            beforeSend: function () {
                ys.showLoading('正在处理中...');
            },
            complete: function () {
                ys.closeLoading();
            },
            success: function (obj) {
                if (obj.Tag == 1) {
                    ys.msgSuccess(obj.Message || '保存成功');
                } else {
                    ys.msgError(obj.Message || '保存失败');
                }
            },
            error: function (xhr) {
                var msg = '保存失败';
                try {
                    if (xhr.responseJSON && xhr.responseJSON.Message) {
                        msg = xhr.responseJSON.Message;
                    }
                } catch (e) { }
                ys.alertError(msg);
            }
        });
    }

    // ---------- 配置项控件渲染（与「系统配置」页保持一致） ----------
    function renderConfForm(list) {
        var html = '<form class="form-horizontal m">';
        for (var i = 0; i < list.length; i++) {
            var item = list[i];
            var val = item.ConfValue === null || item.ConfValue === undefined ? '' : item.ConfValue;
            var spec = item.ConfSpec === null || item.ConfSpec === undefined ? 1 : item.ConfSpec;
            var desc = item.ConfDesc || '';
            // conf_status=0 表示「隐藏」：参数名加删除线、控件禁用（值仍随保存提交，前台读取逻辑不变）
            var isHidden = String(item.ConfStatus) === '0';
            html += '<div class="form-group' + (isHidden ? ' conf-item-disabled' : '') + '" data-conf-id="' + (item.id || item.Id || '') + '" data-conf-spec="' + spec + '">';
            html += '<label class="col-sm-3 control-label' + (isHidden ? ' conf-label-hidden' : '') + '" title="' + escAttr(item.ConfKey || '') + '">' + escHtml(item.ConfTitle || item.ConfKey || '') + '</label>';
            html += '<div class="col-sm-7">';
            html += renderControl(spec, val, item.ConfContent || '', item.id || item.Id || '', isHidden);
            if (desc) {
                html += '<span class="help-block m-b-none" style="font-size:12px;color:#999;">' + escHtml(desc) + '</span>';
            }
            html += '</div>';
            html += '</div>';
        }
        html += '</form>';
        return html;
    }

    // conf_spec：1=多行文本框 2=单选框 3=下拉 4=上传图片
    function renderControl(spec, val, content, confId, disabled) {
        var name = 'conf_' + confId;
        var optionsArray = [];
        var disabledAttr = disabled ? ' disabled' : '';
        if (content) {
            optionsArray = content.split(/\r?\n|,/).map(function (s) { return $.trim(s); }).filter(function (s) { return s !== ''; });
        }
        var html = '';
        if (spec == 1) {
            html += '<textarea id="' + name + '" name="' + name + '" class="form-control" rows="4"' + disabledAttr + '>' + escHtml(val) + '</textarea>';
        } else if (spec == 3) {
            // 下拉统一用 ysComboBox 渲染：选项与当前值放在 data 属性里，插入 DOM 后由 initConfSelects 初始化
            var selectItems = [];
            for (var k = 0; k < optionsArray.length; k++) {
                var opt = optionsArray[k];
                var optVal = opt;
                var optText = opt;
                if (opt.indexOf('=') > -1) {
                    var parts = opt.split('=');
                    optVal = $.trim(parts[0]);
                    optText = $.trim(parts[1]);
                }
                selectItems.push({ Key: optVal, Value: optText });
            }
            html += '<div id="' + name + '" class="conf-select" data-disabled="' + (disabled ? '1' : '0') +
                '" data-value="' + escAttr(val) + '" data-options="' + escAttr(JSON.stringify(selectItems)) + '"></div>';
        } else if (spec == 2) {
            if (optionsArray.length === 0) {
                html += '<div class="text-muted" style="padding-top:7px;">（无选项，请到编辑页配置 conf_content）</div>';
            } else {
                for (var r = 0; r < optionsArray.length; r++) {
                    var ropt = optionsArray[r];
                    var roptVal = ropt;
                    var roptText = ropt;
                    if (ropt.indexOf('=>') > -1) {
                        var rparts = ropt.split('=>');
                        roptText = $.trim(rparts[0]);
                        roptVal = $.trim(rparts[1]);
                    }
                    var rchecked = (String(val) === String(roptVal)) ? ' checked' : '';
                    html += '<label class="radio-inline" style="padding-top:7px;">' +
                        '<input type="radio" name="' + name + '" value="' + escAttr(roptVal) + '"' + rchecked + disabledAttr + ' /> ' + escHtml(roptText) + '</label>';
                }
            }
        } else if (spec == 4) {
            html += '<div id="' + name + '" class="img-box" data-upload="1" data-value="' + escAttr(val) + '"></div>';
        } else {
            html += '<input id="' + name + '" name="' + name + '" type="text" class="form-control" value="' + escAttr(val) + '"' + disabledAttr + ' />';
        }
        return html;
    }

    // conf_spec=3 下拉控件初始化：统一用 ysComboBox 渲染，且不启用下拉搜索输入框
    function initConfSelects(container) {
        $(container).find('.conf-select').each(function () {
            var $box = $(this);
            if ($box.attr('data-inited')) {
                return;
            }
            $box.attr('data-inited', '1');
            var items = [];
            try {
                items = JSON.parse($box.attr('data-options') || '[]');
            } catch (e) {
                items = [];
            }
            if (items.length === 0) {
                $box.html('<div class="text-muted" style="padding-top:7px;">（无选项，请到编辑页配置 conf_content）</div>');
                return;
            }
            var val = $box.attr('data-value') || '';
            // 当前值不在候选里时补一项，避免打开页面保存时被清空
            var matched = val === '';
            for (var i = 0; i < items.length; i++) {
                if (String(items[i].Key) === String(val)) {
                    matched = true;
                    break;
                }
            }
            if (!matched) {
                items.push({ Key: val, Value: '当前值（未在选项里）' });
            }
            // placeholder:false 不生成空选项，行为与原 select（默认选中第一项）保持一致
            $box.ysComboBox({ data: items, class: 'form-control', search: false, placeholder: false });
            if (val !== '') {
                $box.ysComboBox('setValue', val);
            }
            if ($box.attr('data-disabled') === '1') {
                $box.find('select').prop('disabled', true);
            }
        });
    }

    // 上传图片控件初始化（含已有图片回显）
    function initImageUploadControls() {
        $('#basicForm .img-box[data-upload="1"]').each(function () {
            var $box = $(this);
            if ($box.attr('data-inited')) {
                return;
            }
            $box.attr('data-inited', '1');
            $box.imageUpload({
                uploadImage: 'uploadPanConfImage',
                limit: 1,
                context: ctx
            });
            var val = $box.attr('data-value');
            if (val) {
                $box.imageUpload('setImageUrl', val);
            }
        });
    }

    // 图片上传回调：走本站 File/UploadFile 接口
    function uploadPanConfImage(file, callback) {
        var formdata = new FormData();
        formdata.append("fileList", file);
        ys.ajaxUploadFile({
            url: '@Url.Content("~/File/UploadFile")?fileModule=@((int)AggPanSearch.Enum.UploadFileType.News)',
            data: formdata,
            success: function (obj) {
                if (obj.Tag == 1) {
                    if (callback) {
                        callback(ctx + ys.trimStart(obj.Data, '/'));
                    }
                } else {
                    ys.msgError(obj.Message);
                }
            }
        });
    }

    // 转义 HTML
    function escHtml(str) {
        return String(str == null ? '' : str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // 转义属性值
    function escAttr(str) {
        return String(str == null ? '' : str).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
</script>
