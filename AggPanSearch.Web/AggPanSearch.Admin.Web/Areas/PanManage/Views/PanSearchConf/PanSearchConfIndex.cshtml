@using AggPanSearch.Util
@{
    Layout = "~/Views/Shared/_Index.cshtml";
}
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@section header{
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/lib/imageupload/1.0/css/imgup.min.css"))
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/lib/imageupload/1.0/js/imgup.min.js"))
}
<style type="text/css">
    .search-tab-tip {
        font-size: 12px;
        color: #999;
        line-height: 20px;
        margin-bottom: 10px;
    }

    .preview-box {
        margin-top: 12px;
        padding: 12px;
        background: #fafafa;
        border: 1px dashed #e0e0e0;
        border-radius: 6px;
        min-height: 42px;
        line-height: 28px;
    }

    .preview-box .preview-item {
        display: inline-block;
        margin: 0 8px 6px 0;
        padding: 2px 12px;
        background: #fff;
        border: 1px solid #e5e6e7;
        border-radius: 14px;
        font-size: 13px;
        color: #555;
    }

    .preview-box .preview-empty {
        color: #bbb;
        font-size: 13px;
    }

    /* 版权投诉自动生成的关键词：橙色系，与手工维护的屏蔽词区分开 */
    .preview-box .copyright-item {
        background: #fff7e6;
        border-color: #ffd591;
        color: #ad6800;
    }

    /* 网盘类型：勾选框与文字居中对齐，去掉 bootstrap 的绝对定位与左侧留白造成的错位 */
    #cloudTypesBox .checkbox-inline {
        display: inline-flex;
        align-items: center;
        padding-left: 0;
        margin: 0 16px 0 0;
        line-height: 20px;
        vertical-align: middle;
        cursor: pointer;
    }

    #cloudTypesBox .checkbox-inline input[type="checkbox"] {
        position: static;
        float: none;
        margin: 0 6px 0 0;
    }

    .cloud-types-summary {
        margin-bottom: 10px;
        padding: 8px 12px;
        background: #f7f9fb;
        border-left: 3px solid #1ab394;
        border-radius: 3px;
        font-size: 13px;
        color: #555;
        line-height: 22px;
        word-break: break-all;
    }

    .cloud-types-summary .cloud-types-summary-label {
        color: #999;
        margin-right: 6px;
    }

    .cloud-types-summary .cloud-types-summary-value {
        color: #1ab394;
    }

    /* 配置项状态为「隐藏」（conf_status=0）：参数名加删除线，控件区禁用 */
    .conf-label-hidden {
        text-decoration: line-through;
        color: #999 !important;
    }

    .conf-item-disabled .col-sm-7 {
        opacity: .6;
        pointer-events: none;
    }

    .conf-item-disabled input,
    .conf-item-disabled textarea,
    .conf-item-disabled select {
        background-color: #f5f5f5;
        cursor: not-allowed;
    }
</style>
<div class="container-div">
    <div class="row">
        <div class="col-sm-12">
            <div class="tabs-container m-b-sm">
                <div class="ibox-title" style="display:flex; align-items:center; justify-content:space-between;">
                    <h5 style="margin:0;">搜索设置</h5>
                    <div class="ibox-tools" style="position:static; margin:0; align-items:center; display:flex;">
                        <a id="btnSaveCurrent" class="btn btn-primary btn-sm" style="vertical-align:middle;" onclick="saveCurrentTab()">
                            <i class="fa fa-check"></i>&nbsp;保存当前页签
                        </a>
                    </div>
                </div>
                <div class="ibox-content">
                    <ul class="nav nav-tabs" id="searchConfTabs">
                        <li class="tab-item active">
                            <a href="javascript:;" data-tab="basic" onclick="switchTab(this)">搜索设置</a>
                        </li>
                        <li class="tab-item">
                            <a href="javascript:;" data-tab="tgchannels" onclick="switchTab(this)">TG频道</a>
                        </li>
                        <li class="tab-item">
                            <a href="javascript:;" data-tab="plugins" onclick="switchTab(this)">搜索插件</a>
                        </li>
                        <li class="tab-item">
                            <a href="javascript:;" data-tab="cloudtypes" onclick="switchTab(this)">网盘类型</a>
                        </li>
                        <li class="tab-item">
                            <a href="javascript:;" data-tab="blockwords" onclick="switchTab(this)">屏蔽词过滤</a>
                        </li>
                    </ul>
                    <div class="tab-content m-t-md" id="searchConfContent">
                        <!-- Tab1：搜索设置（原「系统配置 - 搜索设置」的配置项，按 pan_conf 动态渲染） -->
                        <div class="tab-pane active in" data-pane="basic">
                            <div class="search-tab-tip">
                                以下配置项由「系统配置 - 搜索设置」迁移而来，保存后前台搜索页刷新即可生效。
                            </div>
                            <div id="basicForm">
                                <div class="text-muted" style="padding:20px;">加载中...</div>
                            </div>
                        </div>
                        <!-- Tab2：TG频道（独立表 pan_search_channel，每个频道一条记录，本页签内直接增删改查） -->
                        <div class="tab-pane" data-pane="tgchannels">
                            <div class="search-tab-tip">
                                每个频道一条记录，可单独启用/停用、分组、排序。只有「启用」状态的频道参与前台全网搜索；
                                若没有任何启用记录，将自动使用系统内置的默认频道列表。此页签的操作即时生效，无需点「保存当前页签」。
                            </div>
                            <!-- 查询条件：与列表页搜索区（#searchDiv）保持同一套排版与样式 -->
                            <div id="tgChannelSearchList" class="search-collapse">
                                <div class="select-list">
                                    <ul>
                                        <li>
                                            <label>频道名：</label>
                                            <input id="tgChannelName" col="name" type="text" placeholder="t.me/s/ 后面的部分" />
                                        </li>
                                        <li>
                                            <label>分组：</label>
                                            <input id="tgChannelCategory" col="category" type="text" placeholder="如 影视 / 短剧" />
                                        </li>
                                        <li>
                                            <label>状态：</label>
                                            <div id="tgChannelStatus" col="status" class="select-wrap"></div>
                                        </li>
                                        <li>
                                            <label>检测资源：</label>
                                            <div id="tgChannelProbe" col="probe" class="select-wrap"></div>
                                        </li>
                                        <li>
                                            <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="btn-group-sm hidden-xs" id="tgChannelToolbar">
                                <a id="btnAdd" class="btn btn-success" onclick="showSaveForm(true)"><i class="fa fa-plus"></i> 新增</a>
                                <a id="btnEdit" class="btn btn-primary disabled" onclick="showSaveForm(false)"><i class="fa fa-edit"></i> 修改</a>
                                <a id="btnDelete" class="btn btn-danger disabled" onclick="deleteForm()"><i class="fa fa-remove"></i> 删除</a>
                                <a id="btnEnable" class="btn btn-info" onclick="setStatus(1)"><i class="fa fa-check-circle"></i> 启用</a>
                                <a id="btnDisable" class="btn btn-warning" onclick="setStatus(0)"><i class="fa fa-ban"></i> 停用</a>
                                <a id="btnResetDefault" class="btn btn-default" onclick="resetDefaultChannels()"><i class="fa fa-refresh"></i> 重置系统默认频道</a>
                                <a id="btnProbe" class="btn btn-default" onclick="probeAllChannels()"><i class="fa fa-stethoscope"></i> 检测频道</a>
                                <a id="btnExport" class="btn btn-default disabled" onclick="exportChannels()"><i class="fa fa-clipboard"></i> 导出频道配置</a>
                            </div>
                            <table id="tgChannelGrid"></table>
                        </div>
                        <!-- Tab3：搜索插件（留空表示启用全部已注册插件） -->
                        <div class="tab-pane" data-pane="plugins">
                            <div class="search-tab-tip">
                                每行一个插件名，用于指定本次搜索启用的搜索插件；留空表示启用全部已注册插件。
                            </div>
                            <textarea id="pluginsInput" class="form-control" rows="10" placeholder="例如：&#10;mock"></textarea>
                            <div class="search-tab-tip" style="margin-top:8px;">
                                已注册插件：
                                <span id="pluginsRegistered">加载中...</span>
                            </div>
                        </div>
                        <!-- Tab4：网盘类型（限制搜索结果返回的网盘类型） -->
                        <div class="tab-pane" data-pane="cloudtypes">
                            <div class="search-tab-tip">
                                勾选需要展示的网盘类型，未勾选任何类型时返回全部类型的结果。类型清单由后台统一提供，新增网盘类型无需改页面。
                            </div>
                            <div class="cloud-types-summary">
                                <span class="cloud-types-summary-label">当前启用：</span><span id="cloudTypesEnabled" class="cloud-types-summary-value">加载中...</span>
                            </div>
                            <div style="margin-bottom:8px;">
                                <a class="btn btn-default btn-sm" onclick="checkAllCloudTypes(true)">全选</a>
                                <a class="btn btn-default btn-sm" onclick="checkAllCloudTypes(false)">全不选</a>
                            </div>
                            <div id="cloudTypesBox" class="preview-box" style="line-height:32px;"></div>
                        </div>
                        <!-- Tab5：屏蔽词过滤（新增功能） -->
                        <div class="tab-pane" data-pane="blockwords">
                            <div class="search-tab-tip">
                                版权投诉自动生成（只读）：由「网盘管理 - 版权投诉」审核通过的作品名自动汇总，与下方手工屏蔽词一起参与过滤；
                                如需移除，请在版权投诉中驳回或删除对应记录。
                                <span class="label label-warning" style="margin-left:6px;">共 <span id="copyrightBlockWordsCount">0</span> 条</span>
                            </div>
                            <div class="preview-box" id="copyrightBlockWordsBox">
                                <span class="preview-empty">加载中...</span>
                            </div>
                            <div class="search-tab-tip" style="margin-top:16px;">
                                手工屏蔽词：多个词用逗号分隔（换行、分号也兼容），搜索结果标题/描述中命中任一词的条目会被直接过滤掉，可用于屏蔽广告、违规内容。
                            </div>
                            <textarea id="blockWordsInput" class="form-control" rows="20" style="min-height:360px;" placeholder="例如：广告,加微信,代写"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    // 当前激活的页签：basic / tgchannels / plugins / cloudtypes / blockwords
    var currentTab = 'basic';
    // 已加载标记，避免重复请求
    var loaded = { basic: false, extra: false };
    // 共用同一份配置数据的页签（首次切换时统一加载）
    // 注意：tgchannels 走独立表 pan_search_channel，不参与 pan_conf 的加载与保存
    var EXTRA_TABS = ['plugins', 'cloudtypes', 'blockwords'];
    // TG频道表格是否已初始化（首次切到该页签时才建表，避免在隐藏容器里计算宽度出错）
    var tgChannelGridInited = false;

    // 网盘类型清单由后端接口返回（PanCloudTypeRegistry），页面不再硬编码类型
    var cloudTypeOptions = [];
    // 后端返回的「当前启用」类型（为空表示不过滤，等同全部启用）
    var cloudTypeEnabled = [];

    $(function () {
        loadBasic();
        // 频道查询条件下拉：不启用下拉搜索输入框，选「全部」时提交空值
        $("#tgChannelStatus").ysComboBox({
            data: [{ Key: '1', Value: '启用' }, { Key: '0', Value: '停用' }],
            search: false
        });
        $("#tgChannelProbe").ysComboBox({
            data: [
                { Key: 'today', Value: '今日有更新' },
                { Key: 'none', Value: '无网盘资源' },
                { Key: 'inaccessible', Value: '不可访问' },
                { Key: 'week', Value: '最近1周有更新' },
                { Key: 'month', Value: '最近1个月有更新' },
                { Key: 'halfyear', Value: '最近6个月有更新' },
                { Key: 'year', Value: '最近1年有更新' }
            ],
            search: false
        });
        // 回车查询：aggpansearch-init.js 的全局回车绑定只认 #searchDiv，本页不再用该节点，这里单独绑
        $('#tgChannelSearchList').on('keyup', 'input', function (e) {
            if (e.which === 13) {
                searchGrid();
            }
        });
        // 勾选变化时实时刷新「当前启用」汇总
        $('#cloudTypesBox').on('change', 'input[name="cloudType"]', function () {
            renderCloudTypeEnabled();
        });
    });

    // 切换页签：懒加载对应数据
    function switchTab(el) {
        var tab = el.getAttribute('data-tab') || 'basic';
        $('#searchConfTabs li').removeClass('active');
        $(el).parent('li').addClass('active');
        $('#searchConfContent .tab-pane').removeClass('active in');
        $('#searchConfContent .tab-pane[data-pane="' + tab + '"]').addClass('active in');
        currentTab = tab;

        if (tab === 'basic' && !loaded.basic) {
            loadBasic();
        } else if (tab === 'tgchannels') {
            initTgChannelGrid();
        } else if (EXTRA_TABS.indexOf(tab) > -1 && !loaded.extra) {
            loadExtra();
        }
    }

    // ---------- Tab1：搜索设置 ----------
    function loadBasic() {
        ys.ajax({
            url: '@Url.Content("~/PanManage/PanSearchConf/GetListJson")',
            type: 'get',
            success: function (obj) {
                loaded.basic = true;
                if (obj.Tag == 1) {
                    var list = obj.Data || [];
                    $('#basicForm').html(list.length === 0
                        ? '<div class="text-muted" style="padding:20px;">暂无搜索配置项，可在「系统配置 - 配置项管理」中按 conf_type=1 新增</div>'
                        : renderConfForm(list));
                    initConfSelects('#basicForm');
                    initImageUploadControls();
                } else {
                    $('#basicForm').html('<div class="text-danger" style="padding:20px;">加载失败：' + escHtml(obj.Message || '') + '</div>');
                }
            }
        });
    }

    // ---------- 其余页签：搜索插件 / 网盘类型 / 屏蔽词 ----------
    function loadExtra() {
        ys.ajax({
            url: '@Url.Content("~/PanManage/PanSearchConf/GetExtraJson")',
            type: 'get',
            success: function (obj) {
                loaded.extra = true;
                if (obj.Tag == 1 && obj.Data) {
                    var data = obj.Data;
                    $('#pluginsInput').val(joinCommas(data['search_plugins'] || ''));
                    // 网盘类型的类型清单与当前启用状态由专用接口返回
                    loadCloudTypes();
                    $('#blockWordsInput').val(joinCommas(data['search_block_words'] || ''));
                    // 版权投诉自动生成的关键词（只读）：以逗号分隔存储，同样按逗号拆分展示
                    renderCopyrightBlockWords(data['copyright_block_keywords'] || '');
                }
            }
        });
        loadRegisteredPlugins();
    }

    // 配置统一以逗号分隔存储，后台显示时同样按逗号分隔（去空、去重）
    function joinCommas(value) {
        return parseLines(value).join(',');
    }

    // 加载运行时已注册的插件名，便于填写「搜索插件」
    function loadRegisteredPlugins() {
        ys.ajax({
            url: '@Url.Content("~/PanManage/PanSearchConf/GetPluginListJson")',
            type: 'get',
            success: function (obj) {
                if (obj.Tag == 1 && obj.Data && obj.Data.length > 0) {
                    $('#pluginsRegistered').html(obj.Data.map(function (n) { return escHtml(n); }).join('、'));
                } else {
                    $('#pluginsRegistered').text('暂无（未注册额外插件时使用内置数据源）');
                }
            }
        });
    }

    // ---------- Tab2：TG频道（独立表 pan_search_channel） ----------
    var tgStatusTextMap = {
        Status: { '1': '启用', '0': '停用' },
        IsSys: { '1': '内置', '0': '自定义' }
    };

    // 首次切到「TG频道」页签时再初始化表格：隐藏容器里取不到宽度，必须先显示再建表
    function initTgChannelGrid() {
        if (tgChannelGridInited) {
            // 表格已存在，仅需重新计算宽度（切换页签后容器宽度可能变化）
            $('#tgChannelGrid').bootstrapTable('resetView');
            return;
        }
        tgChannelGridInited = true;
        $('#tgChannelGrid').ysTable({
            // 不分页：一次性取全部频道，用客户端 loading（数据由 loadTgChannelData 手动加载）
            pagination: false,
            sidePagination: 'client',
            // 保留内置「刷新」图标：表格没有 url，点了不会自动请求，下面在初始化后把它的点击
            // 事件改绑到 searchGrid()，效果等同于按查询区的「搜索」
            showRefresh: true,
            // 不用 #toolbar：aggpansearch-init 会按「当前页面 URL」推断按钮权限码去删按钮，
            // 本页 URL 属于 PanSearchConf，与按钮权限码(pan:pansearchchannel:*)不匹配，会把整条工具条删掉
            toolbar: '#tgChannelToolbar',
            sortName: 'sort',
            sortOrder: 'asc',
            columns: [
                { checkbox: true, visible: true },
                { field: 'Id', title: 'Id', visible: false },
                { field: 'Name', title: '频道名',width:120 },
                { field: 'Category', title: '分组' },
                { field: 'Sort', title: '排序', width: 70 },
                { field: 'Weight', title: '权重', width: 70 },
                {
                    field: 'Status', title: '状态', width: 80,
                    formatter: function (value) { return renderTgBadge(value, 'Status'); }
                },
                {
                    field: 'IsSys', title: '来源', width: 80,
                    formatter: function (value) { return renderTgBadge(value, 'IsSys'); }
                },
                { field: 'Remark', title: '备注', visible: false },
                {
                    field: 'LastUpdate', title: '最近资源时间', width: 170,
                    formatter: renderTgLastUpdate
                },
                {
                    field: 'BaseModifyTime', title: '更新时间', width: 160,
                    formatter: renderTgTime
                },
                { field: 'open', title: '打开频道', width: 90, align: 'center', formatter: renderTgChannelLink },
            ],
            onCheck: updateTgToolbar,
            onUncheck: updateTgToolbar,
            onCheckAll: updateTgToolbar,
            onUncheckAll: updateTgToolbar,
        });
        // 表格没有 url，bootstrap-table 自带的刷新只会重绘不会重新请求，
        // 这里把刷新图标的点击事件接管为重新加载数据（检测进行中会由 searchGrid 内部忽略）
        $('#tgChannelGrid').closest('.bootstrap-table').find('button[name="refresh"]')
            .off('click').on('click', function (e) {
                e.preventDefault();
                searchGrid();
            });
        loadTgChannelData();
        // 页签切换后容器宽度可能仍在变化，下一帧再校正一次
        setTimeout(function () {
            $('#tgChannelGrid').bootstrapTable('resetView');
        }, 0);
    }

    // 一次性加载全部频道（不分页），不再自动检测，检测由工具条上的「检测频道」按钮触发
    function loadTgChannelData() {
        ys.ajax({
            url: '@Url.Content("~/PanManage/PanSearchChannel/GetListJson")',
            type: 'get',
            data: $('#tgChannelSearchList').getWebControls({}),
            success: function (obj) {
                if (!obj || obj.Tag != 1) {
                    ys.alertError((obj && obj.Message) || '数据加载失败！');
                    return;
                }
                $('#tgChannelGrid').bootstrapTable('load', obj.Data || []);
                updateTgToolbar();
            }
        });
    }

    function renderTgBadge(value, field) {
        if (ys.isNullOrEmpty(value)) {
            return '';
        }
        var key = String(value);
        var texts = tgStatusTextMap[field] || {};
        var text = texts[key] || key;
        var cls = (key === '1') ? 'badge badge-primary' : 'badge badge-warning';
        return '<span class="' + cls + '">' + text + '</span>';
    }

    function renderTgTime(value) {
        if (ys.isNullOrEmpty(value)) {
            return '';
        }
        return String(value).replace('T', ' ').substring(0, 19);
    }

    // 「打开频道」列：新窗口打开 t.me/s/{频道名}
    function renderTgChannelLink(value, row) {
        var name = row && row.Name ? String(row.Name) : '';
        if (name === '') {
            return '';
        }
        var url = 'https://t.me/s/' + encodeURIComponent(name);
        return '<a href="' + escAttr(url) + '" target="_blank" rel="noopener noreferrer" title="' + escAttr(url) + '">打开</a>';
    }

    // 最近资源时间：先按库里已保存的检测结果渲染，检测过程中/检测完成后由脚本直接更新这个 span
    function renderTgLastUpdate(value, row) {
        var text = '-';
        var cls = '';
        if (row && row.ProbeStatus === 0) {
            text = '不可访问';
            cls = ' class="text-danger"';
        } else if (ys.isNullOrEmpty(value)) {
            text = (row && row.ProbeStatus === 1) ? '无网盘资源' : '-';
            cls = ' class="text-muted"';
        } else {
            text = renderTgTime(value);
        }
        return '<span id="tgLastUpdate_' + row.Id + '"' + cls + '>' + text + '</span>';
    }

    function setTgLastUpdate(id, text, cls, title) {
        var $span = $('#tgLastUpdate_' + id);
        if ($span.length === 0) {
            return;
        }
        $span.removeClass('text-danger text-muted text-success').text(text);
        if (cls) {
            $span.addClass(cls);
        }
        // 悬停显示探测说明（例如「检测失败：请求被限流(429)」）
        $span.attr('title', title || '');
    }

    // 检测中标记：为 true 时页面所有操作按钮不可用
    var tgProbeRunning = false;
    var tgProbeRunId = 0;

    // 切换检测中状态：按钮显示/隐藏转动图标，同时禁用/恢复页面上的操作按钮
    function setTgProbeBusy(busy) {
        tgProbeRunning = busy;
        var $btnProbe = $('#btnProbe');
        if (busy) {
            $btnProbe.addClass('disabled').html('<i class="fa fa-spinner fa-spin"></i> 检测中...');
            // 除「检测频道」自身外，工具条上的所有按钮全部禁用
            $('#tgChannelToolbar a').not('#btnProbe').addClass('disabled');
            $('#btnSearch, #btnSaveCurrent').addClass('disabled');
            $('#tgChannelGrid').closest('.bootstrap-table').find('button[name="refresh"]').prop('disabled', true);
        } else {
            $btnProbe.removeClass('disabled').html('<i class="fa fa-stethoscope"></i> 检测频道');
            $('#tgChannelToolbar a').not('#btnProbe').removeClass('disabled');
            $('#btnSearch, #btnSaveCurrent').removeClass('disabled');
            $('#tgChannelGrid').closest('.bootstrap-table').find('button[name="refresh"]').prop('disabled', false);
            // 修改/删除需要按选中行重新计算
            updateTgToolbar();
        }
    }

    // 点击「检测频道」：逐条（串行）检测频道是否可访问 + 最近一次发布网盘资源链接的时间
    // 每次手动触发都会自增 runId，旧队列检测到 runId 变化立即退出，避免重复请求
    function probeAllChannels() {
        if (tgProbeRunning || !tgChannelGridInited) {
            return;
        }
        var rows = $('#tgChannelGrid').bootstrapTable('getData') || [];
        if (rows.length === 0) {
            ys.alertWarning('当前没有可检测的频道');
            return;
        }
        var runId = ++tgProbeRunId;
        var index = 0;
        var total = rows.length;
        var $btnProbe = $('#btnProbe');
        setTgProbeBusy(true);

        function refreshProbeLabel() {
            $btnProbe.html('<i class="fa fa-spinner fa-spin"></i> 检测中(' + index + '/' + total + ')');
        }
        refreshProbeLabel();

        function probeNext() {
            if (runId !== tgProbeRunId) {
                return;
            }
            if (index >= rows.length) {
                setTgProbeBusy(false);
                return;
            }
            var row = rows[index++];
            refreshProbeLabel();
            setTgLastUpdate(row.Id, '检测中...', 'text-muted');
            ys.ajax({
                url: '@Url.Content("~/PanManage/PanSearchChannel/CheckChannelJson")' + '?id=' + row.Id,
                type: 'post',
                // 串行检测几十条，不能每条都弹「正在处理中」遮罩
                beforeSend: function () { },
                complete: function () { },
                success: function (obj) {
                    if (runId !== tgProbeRunId) {
                        return;
                    }
                    if (obj.Tag == 1 && obj.Data) {
                        var data = obj.Data;
                        var msg = data.Message || '';
                        // Outcome：1=可访问 2=确定不可访问 0=检测失败（网络异常/超时/限流）
                        var outcome = (data.Outcome === undefined || data.Outcome === null)
                            ? (data.Accessible ? 1 : 2)
                            : Number(data.Outcome);
                        if (outcome === 1) {
                            if (ys.isNullOrEmpty(data.LastUpdate)) {
                                setTgLastUpdate(row.Id, '无网盘资源', 'text-muted', msg);
                            } else {
                                setTgLastUpdate(row.Id, renderTgTime(data.LastUpdate), '', msg);
                            }
                        } else if (outcome === 2) {
                            setTgLastUpdate(row.Id, '不可访问', 'text-danger', msg);
                        } else {
                            setTgLastUpdate(row.Id, '检测失败', 'text-danger', msg);
                        }
                    } else {
                        setTgLastUpdate(row.Id, '检测失败', 'text-danger', obj.Message || '');
                    }
                    // 请求之间留一点间隔，避免短时间内大量请求被 t.me 限流
                    setTimeout(probeNext, 250);
                },
                error: function (xhr, status) {
                    if (runId !== tgProbeRunId) {
                        return;
                    }
                    setTgLastUpdate(row.Id, '检测失败', 'text-danger',
                        '检测失败：' + (status || '网络异常'));
                    setTimeout(probeNext, 250);
                }
            });
        }
        probeNext();
    }

    // 导出频道配置：弹窗展示全部频道名（英文逗号分隔），并提供「复制」按钮
    function exportChannels() {
        if (tgProbeRunning || !tgChannelGridInited) {
            return;
        }
        var rows = $('#tgChannelGrid').bootstrapTable('getSelections') || [];
        if (rows.length === 0) {
            ys.msgWarning('请先选择要导出的频道');
            return;
        }
        var names = [];
        for (var i = 0; i < rows.length; i++) {
            var name = rows[i] && rows[i].name ? $.trim(String(rows[i].name)) : '';
            if (name !== '' && names.indexOf(name) === -1) {
                names.push(name);
            }
        }
        if (names.length === 0) {
            ys.alertWarning('选中的频道没有可导出的频道名');
            return;
        }
        var text = names.join(',');
        var html = '<div style="padding:12px;">'
            + '<div class="search-tab-tip" style="margin-bottom:8px;">已选中 ' + names.length + ' 个频道，频道名用英文逗号分隔：</div>'
            + '<textarea id="tgExportText" class="form-control" rows="12" readonly style="resize:vertical;font-family:Consolas,Monaco,monospace;">' + escHtml(text) + '</textarea>'
            + '<div style="margin-top:10px;text-align:right;">'
            + '<a id="tgExportCopy" class="btn btn-primary btn-sm" onclick="copyTgExportText()"><i class="fa fa-copy"></i>&nbsp;复制</a>'
            + '</div>'
            + '</div>';
        ys.openDialog({
            type: 1,
            title: '导出频道配置',
            width: '640px',
            height: '440px',
            btn: ['关闭'],
            content: html
        });
    }

    // 复制弹窗中的频道名：优先用剪贴板 API，失败时回退到选中 + execCommand
    function copyTgExportText() {
        var $ta = $('#tgExportText');
        if ($ta.length === 0) {
            return;
        }
        var text = $ta.val();
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(text).then(function () {
                ys.msgSuccess('已复制到剪贴板');
            }, function () {
                fallbackCopyTgExport($ta);
            });
        } else {
            fallbackCopyTgExport($ta);
        }
    }

    function fallbackCopyTgExport($ta) {
        try {
            $ta[0].select();
            $ta[0].setSelectionRange(0, $ta[0].value.length);
            if (document.execCommand('copy')) {
                ys.msgSuccess('已复制到剪贴板');
            } else {
                ys.msgWarning('复制失败，请手动选中后按 Ctrl+C 复制');
            }
        } catch (e) {
            ys.msgWarning('复制失败，请手动选中后按 Ctrl+C 复制');
        }
    }

    // 选中行变化时同步「修改/删除」按钮的可用状态（检测进行中一律禁用）
    function updateTgToolbar() {
        var rows = $('#tgChannelGrid').bootstrapTable('getSelections') || [];
        $('#btnEdit').toggleClass('disabled', tgProbeRunning || rows.length !== 1);
        $('#btnDelete').toggleClass('disabled', tgProbeRunning || rows.length === 0);
        // 导出需要先选中行
        $('#btnExport').toggleClass('disabled', tgProbeRunning || rows.length === 0);
    }

    // 供子页面（PanSearchChannelForm）保存成功后回调；回车搜索也会调用
    function searchGrid() {
        if (!tgChannelGridInited || tgProbeRunning) {
            // 表格还没初始化（例如在其它页签按了回车）或正在检测，直接忽略
            return;
        }
        resetToolbarStatus();
        loadTgChannelData();
    }

