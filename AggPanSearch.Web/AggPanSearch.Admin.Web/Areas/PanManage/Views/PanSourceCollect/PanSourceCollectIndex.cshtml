@{
    Layout = "~/Views/Shared/_Index.cshtml";
}

@using AggPanSearch.Util
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostingEnvironment
@section header{
    @* 卡片列表公共样式：采集资源页与本地资源页共用 *@
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/aggpansearch/css/aggpansearch-card-list.min.css"))
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/pansou/css/pan-source-collect.min.css"))
    @* 通用图片查看器样式：卡片封面点击查看大图 *@
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/aggpansearch/css/aggpansearch-image-viewer.min.css"))
}

<div class="container-div">
    @* 进度悬浮区：四个进度条统一固定在视口顶部中间，脱离文档流，始终可见 *@
    <div id="collectProgressPanel" class="collect-progress-panel">
        @* 采集进度：提交任务后显示，结束时自动隐藏 *@
        <div id="collectProgressBar" class="collect-progress-bar col-sm-12" style="display:none;">
            <div class="progress" style="margin-bottom:6px;height:16px;">
                <div id="collectProgressInner" class="progress-bar progress-bar-striped active" role="progressbar" style="width:0%;"></div>
            </div>
            <span id="collectProgressText" class="collect-progress-text"></span>
            <a id="btnCancelCollect" class="btn btn-warning btn-xs collect-progress-cancel" style="display:none;" onclick="cancelCollect()"><i class="fa fa-stop"></i> 取消采集</a>
        </div>
        @* 转存进度：把选中的夸克资源转存到网盘「采集资源」目录并生成永久分享链接 *@
        <div id="transferProgressBar" class="collect-progress-bar col-sm-12" style="display:none;">
            <div class="progress" style="margin-bottom:6px;height:16px;">
                <div id="transferProgressInner" class="progress-bar progress-bar-striped active" role="progressbar" style="width:0%;"></div>
            </div>
            <span id="transferProgressText" class="collect-progress-text"></span>
            <a id="btnCancelTransfer" class="btn btn-warning btn-xs collect-progress-cancel" style="display:none;" onclick="cancelTransfer()"><i class="fa fa-stop"></i> 取消转存</a>
        </div>
        @* 补图进度：把原图片下载到本机并回写本地图片，失败的原图会被剔除 *@
        <div id="imageProgressBar" class="collect-progress-bar col-sm-12" style="display:none;">
            <div class="progress" style="margin-bottom:6px;height:16px;">
                <div id="imageProgressInner" class="progress-bar progress-bar-striped active" role="progressbar" style="width:0%;"></div>
            </div>
            <span id="imageProgressText" class="collect-progress-text"></span>
            <a id="btnCancelImageBackfill" class="btn btn-warning btn-xs collect-progress-cancel" style="display:none;" onclick="cancelImageBackfill()"><i class="fa fa-stop"></i> 取消补图</a>
        </div>
        @* 自动补图进度：采集入库后由后台队列自动下载本地图片，页面实时展示处理进度 *@
        <div id="autoImageProgressBar" class="collect-progress-bar col-sm-12" style="display:none;">
            <div class="progress" style="margin-bottom:6px;height:16px;">
                <div id="autoImageProgressInner" class="progress-bar progress-bar-striped active" role="progressbar" style="width:0%;"></div>
            </div>
            <span id="autoImageProgressText" class="collect-progress-text"></span>
        </div>
    </div>
    <div class="collect-layout">
        @* 左栏：站点配置（站点名称 + 站点链接，采集地址在采集弹窗中手输） *@
        <div class="collect-side">
            <div class="side-head">
                <span class="side-title">站点采集</span>
                <span id="siteCount" class="side-count">0</span>
            </div>
            <a class="btn btn-primary btn-sm btn-add-site" onclick="showSiteForm()"><i class="fa fa-plus"></i>&nbsp;添加站点</a>
            <div id="siteCardList" class="site-card-list"></div>
            <div id="siteEmpty" class="site-empty">还没有站点，点击「添加站点」开始配置</div>
        </div>
        @* 右栏：已采集资源列表 *@
        <div class="collect-main">
            <div class="row">
                <div id="searchDiv" class="col-sm-12 search-collapse">
                    <div class="select-list">
                        <ul>
                            <li>
                                <label>采集来源：</label>
                                <span id="collectSource" col="collect_source" class="select-wrap"></span>
                            </li>
                            <li>
                                <label>分类：</label>
                                <span id="sourceCategory" col="source_category_id" class="select-wrap"></span>
                            </li>
                            <li>
                                <label>资源名称：</label>
                                <input id="resourceName" col="resource_name" type="text" placeholder="支持模糊查询" />
                            </li>
                            <li>
                                <label>链接状态：</label>
                                <span id="isLinkValid" col="is_link_valid" class="select-wrap"></span>
                            </li>
                            <li class="select-time">
                                <label>采集时间：</label>
                                <input id="startTime" col="startTime" type="text" class="time-input" placeholder="开始时间" />
                                <span>-</span>
                                <input id="endTime" col="endTime" type="text" class="time-input" placeholder="结束时间" />
                            </li>
                            <li>
                                <a id="btnSearch" class="btn btn-primary btn-sm" onclick="searchGrid()"><i class="fa fa-search"></i>&nbsp;搜索</a>
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="btn-group-sm hidden-xs collect-toolbar" id="toolbar">
                    @* 卡片列表无表头，用这里的复选框代替表格表头的全选；勾选范围为当前页 *@
                    <label class="collect-check-all" title="勾选 / 取消勾选当前页全部资源">
                        <input type="checkbox" id="chkSelectAllPage" />
                        <span>全选本页</span>
                    </label>
                    <a id="btnAdd" class="btn btn-success" onclick="showSaveForm(true)"><i class="fa fa-plus"></i> 新增</a>
                    @* 批量删除勾选卡片；单张卡片的修改 / 删除在卡片底部
                       “下载图片到本地”已移除手动入口：采集入库后由后台自动补图，下载失败的失效原图会被剔除 *@
                    <a id="btnDelete" class="btn btn-danger disabled" onclick="deleteSelectedRows()"><i class="fa fa-remove"></i> 删除</a>
                    <a id="btnTransfer" class="btn btn-primary disabled" onclick="transferToLocal()"><i class="fa fa-cloud-upload"></i> 转存并分享</a>
                </div>
                @* 保留 #gridTable：分页、勾选、请求仍由 bootstrap-table 负责，
                   卡片化由 grid.js 的单卡片列渲染 + aggpansearch-card-list.css 的网格布局完成。
                   去掉 data-mobile-responsive，避免窄屏时 bootstrap-table 把行重排成内置卡片，与自定义卡片冲突。 *@
                <div class="col-sm-12 select-table collect-card-table">
                    <table id="gridTable"></table>
                </div>
            </div>
        </div>
    </div>
</div>

@section footer{
    <script type="text/javascript">
        // 接口地址由 Razor 生成，静态 js 只读取该对象，避免在静态文件中出现 Razor 表达式
        window.PanSourceCollectApi = {
            pageList: '@Url.Content("~/PanManage/PanSourceCollect/GetPageListJson")',
            siteList: '@Url.Content("~/PanManage/PanSourceCollect/GetSiteListJson")',
            saveSite: '@Url.Content("~/PanManage/PanSourceCollect/SaveSiteJson")',
            deleteSite: '@Url.Content("~/PanManage/PanSourceCollect/DeleteSiteJson")',
            fetchSiteCategories: '@Url.Content("~/PanManage/PanSourceCollect/FetchSiteCategoriesJson")',
            saveSiteCategories: '@Url.Content("~/PanManage/PanSourceCollect/SaveSiteCategoriesJson")',
            categoryOptions: '@Url.Content("~/PanManage/PanSourceCollect/GetSourceCategoryOptionJson")',
            startCollect: '@Url.Content("~/PanManage/PanSourceCollect/StartCollectJson")',
            progress: '@Url.Content("~/PanManage/PanSourceCollect/GetCollectProgressJson")',
            cancel: '@Url.Content("~/PanManage/PanSourceCollect/CancelCollectJson")',
            backfillImage: '@Url.Content("~/PanManage/PanSourceCollect/BackfillImageJson")',
            imageProgress: '@Url.Content("~/PanManage/PanSourceCollect/GetImageProgressJson")',
            cancelImageBackfill: '@Url.Content("~/PanManage/PanSourceCollect/CancelBackfillImageJson")',
            autoImageProgress: '@Url.Content("~/PanManage/PanSourceCollect/GetAutoBackfillProgressJson")',
            transfer: '@Url.Content("~/PanManage/PanSourceCollect/TransferToLocalJson")',
            transferProgress: '@Url.Content("~/PanManage/PanSourceCollect/GetTransferProgressJson")',
            cancelTransfer: '@Url.Content("~/PanManage/PanSourceCollect/CancelTransferJson")',
            deleteForm: '@Url.Content("~/PanManage/PanSourceCollect/DeleteFormJson")',
            form: '@Url.Content("~/PanManage/PanSourceCollect/PanSourceCollectForm")',
            paramForm: '@Url.Content("~/PanManage/PanSourceCollect/PanSourceCollectParamForm")',
            categoryForm: '@Url.Content("~/PanManage/PanSourceCollect/PanSourceCollectCategoryForm")'
        };
        $(function () {
            PanSourceCollect.init();
        });
    </script>
    @* 通用图片查看器：需在业务脚本之前加载，卡片封面点击时调用 ys.imageViewer.open *@
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/aggpansearch/js/aggpansearch-image-viewer.min.js"))
    @* 卡片列表公共脚本：提供 ys.cardList 渲染片段与卡片交互 *@
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/aggpansearch/js/aggpansearch-card-list.min.js"))
    @BundlerHelper.Render(HostingEnvironment.ContentRootPath, Url.Content("~/pansou/js/pan-source-collect.min.js"))
}
