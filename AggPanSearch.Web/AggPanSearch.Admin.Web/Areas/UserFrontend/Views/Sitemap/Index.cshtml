@using System.Linq
@using AggPanSearch.Admin.Web.Areas.UserFrontend.Models

@model List<CategoryItem>

@{
    var Config = (SiteConfig)(ViewData["Config"] ?? new SiteConfig());
    // 资源总数：各分类归属资源之和（卡片上展示的数量徽标与之一致）
    var resourceTotal = Model.Sum(item => item.Count);
}
@section Head {
    <link rel="stylesheet" href="/userfrontend/css/sitemap.css?v=20261116a" />
}

<div class="sm-page">
    @* 标题区：站点地图 + 统计 *@
    <section class="sm-hero">
        <h1>网站地图</h1>
        <p class="sm-hero-desc">全站栏目与资源分类索引，点击任意入口即可直达对应页面。</p>
        <p class="sm-stats">
            共 <b>@Model.Count</b> 个分类 · <b>@resourceTotal</b> 条资源
        </p>
    </section>

    @* 栏目导航：全站一级入口 *@
    <section class="sm-stage">
        <h2 class="sm-stage-title">栏目导航</h2>
        <nav class="sm-nav">
            <a class="sm-nav-card" href="/">
                <span class="sm-nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 10.5 12 3l9 7.5" />
                        <path d="M5 9.5V21h14V9.5" />
                        <path d="M9.5 21v-6h5v6" />
                    </svg>
                </span>
                <span class="sm-nav-text">
                    <strong>首页</strong>
                    <em>资源搜索与热门推荐</em>
                </span>
            </a>

            <a class="sm-nav-card" href="/category">
                <span class="sm-nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                </span>
                <span class="sm-nav-text">
                    <strong>资源分类</strong>
                    <em>按分类浏览全部资源</em>
                </span>
            </a>

            <a class="sm-nav-card" href="/copyright">
                <span class="sm-nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l7 3v5.5c0 4.4-3 8.1-7 9.5-4-1.4-7-5.1-7-9.5V6l7-3z" />
                        <path d="M9.5 12.2l1.8 1.8 3.4-3.6" />
                    </svg>
                </span>
                <span class="sm-nav-text">
                    <strong>版权声明</strong>
                    <em>版权保护与侵权投诉</em>
                </span>
            </a>

            <a class="sm-nav-card" href="/banned_words">
                <span class="sm-nav-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="8.5" />
                        <path d="M6.4 6.4l11.2 11.2" />
                    </svg>
                </span>
                <span class="sm-nav-text">
                    <strong>屏蔽词列表</strong>
                    <em>搜索结果过滤关键词公示</em>
                </span>
            </a>
        </nav>
    </section>

    @* 分类网格：每个分类直达对应的分类资源页 *@
    <section class="sm-stage">
        <h2 class="sm-stage-title">资源分类</h2>
        @if (Model.Count == 0)
        {
            <div class="sm-empty">暂无可展示的分类</div>
        }
        else
        {
            <div class="sm-grid">
                @foreach (var category in Model)
                {
                    <a class="sm-cat" href="/category?categoryId=@category.Id">
                        <span class="sm-cat-name">@category.Name</span>
                        <span class="sm-cat-count">@category.Count</span>
                    </a>
                }
            </div>
            <div class="sm-more">
                <a href="/category">浏览全部资源 →</a>
            </div>
        }
    </section>
</div>
